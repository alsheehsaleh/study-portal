---
import "../styles/global.css";

export interface Props {
  title: string;
  proxy?: boolean;
}

const { title, proxy = false } = Astro.props;
---

<!doctype html>
<html lang="en" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {
      proxy && (
        <>
          <script is:inline src="/baremux/index.js"></script>
          <script is:inline src="/learn/scramjet.all.js"></script>
          <script src="../scripts/proxy.ts"></script>
        </>
      )
    }

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-QKPZDPQGCR"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-QKPZDPQGCR");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>